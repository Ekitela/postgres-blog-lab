Table tenants {
  id int [pk, increment]
  name varchar(150) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
}

Table users {
  id int [pk, increment]
  tenant_id int [not null, ref: > tenants.id]
  username varchar(100) [not null, unique]
  role varchar(50) [not null]
  password_hash text [not null]
}

Table categories {
  id int [pk, increment]
  name varchar(150) [not null]
  parent_id int [ref: > categories.id]
}

Table students {
  id int [pk, increment]
  tenant_id int [not null, ref: > tenants.id]
  name varchar(100) [not null]
  email varchar(150) [not null, unique]
  phone varchar(30)
  created_at timestamptz [not null, default: `now()`]
}

Table courses {
  id int [pk, increment]
  tenant_id int [not null, ref: > tenants.id]
  category_id int [ref: > categories.id]
  name varchar(150) [not null]
  code varchar(50) [not null, unique]
  description text
}

Table enrollments {
  id int [pk, increment]
  tenant_id int [not null, ref: > tenants.id]
  student_id int [not null, ref: > students.id]
  course_id int [not null, ref: > courses.id]
  enrolled_at timestamptz [not null, default: `now()`]
  status varchar(30) [not null, default: 'active']

  Indexes {
    (student_id, course_id) [unique]
  }
}

Table results {
  id int [pk, increment]
  tenant_id int [not null, ref: > tenants.id]
  enrollment_id int [not null, ref: > enrollments.id]
  score decimal(5,2)
  grade varchar(5)
  recorded_at timestamptz [not null, default: `now()`]
}

Table audit_log {
  id bigint [pk, increment]
  tbl text [not null]
  op text [not null]
  old_row jsonb
  new_row jsonb
  changed_by text [not null, default: `current_user`]
  at timestamptz [not null, default: `now()`]
}

Ref: tenants.id < students.tenant_id
Ref: tenants.id < courses.tenant_id
Ref: tenants.id < enrollments.tenant_id
Ref: tenants.id < results.tenant_id
Ref: tenants.id < users.tenant_id
Ref: categories.id < courses.category_id
Ref: students.id < enrollments.student_id
Ref: courses.id < enrollments.course_id
Ref: enrollments.id < results.enrollment_id
Ref: categories.id < categories.parent_id
